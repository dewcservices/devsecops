// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "python-uv-devcontainer",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": "../",
		"target": "dev"
	},
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {}
	},
	"workspaceFolder": "/app",
	// uncomment if the app/source directory is in a sub folder
	// "workspaceMount": "source=${localWorkspaceFolder}/myApp,target=/app,type=bind",

	//may be needed for Podman
	// "runArgs": [
	// 	"--userns=keep-id",
	// 	"--pid=host"
	// ],

	// Mount your personal git, bash and ssh config files so you can use your 
	// existing ssh keys and git config inside the dev container.
	"mounts": [
		"source=${env:HOME}/.gitconfig,target=/home/default/.gitconfig,readonly,type=bind",
		"source=${env:HOME}/.ssh,target=/home/default/.ssh,readonly,type=bind"
	],

	"customizations": {
		"vscode": {
		  "extensions": [
			"ms-python.debugpy",
			"ms-python.python",
			"charliermarsh.ruff",
			// optional
			"ms-python.mypy-type-checker", //replace with Red Knot when released
			"ms-azuretools.vscode-containers",
			"Semgrep.semgrep",
			"AquaSecurityOfficial.trivy-vulnerability-scanner",
			"GitHub.vscode-github-actions",
			"eamodio.gitlens",
			"redhat.vscode-yaml",
			"redhat.vscode-xml",
			"ecmel.vscode-html-css",
			"bierner.markdown-mermaid",
			"esbenp.prettier-vscode",
			"mechatroner.rainbow-csv",
			"editorconfig.editorconfig"
		],
		  "settings": {
			"[python]": {
			  "editor.defaultFormatter": "charliermarsh.ruff",
			},
			 "editor.tabSize": 4,
			 "workbench.tree.indent": 14,
			 "trivy.offlineScan": true           
			 //"files.autoSaveWhenNoErrors": true,
			 //"files.autoSaveWorkspaceFilesOnly": true
		  }
		}
	  },

	"postCreateCommand": [ "uv", "venv" ]
	  
}